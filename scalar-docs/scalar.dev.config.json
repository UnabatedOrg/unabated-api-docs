{
  "$schema": "https://cdn.scalar.com/schema/scalar-config-next.json",
  "scalar": "2.0.0",
  "info": {
    "title": "Unabated API - Dev",
    "description": "Market data for developers, content partners, and the agents helping them.",
    "version": "v1"
  },
  "siteConfig": {
    "customDomain": "docs-sandbox.unabated.com",
    "subdomain": "unabated-sandbox",
    "footer": {
      "filepath": "footer.html"
    },
    "head": {
      "title": "Unabated API - Sandbox",
      "links": [],
      "meta": [
        {
          "name": "description",
          "content": "Market data for developers, content partners, and the agents helping them."
        }
      ],
      "styles": [
        {
          "path": "assets/docs.css"
        }
      ],
      "scripts": [
        {
          "path": "assets/docs.js",
          "tagPosition": "bodyClose"
        }
      ]
    },
    "routing": {
      "redirects": [
        {
          "from": "/",
          "to": "/start/quickstart"
        },
        {
          "from": "/guide",
          "to": "/start/quickstart"
        },
        {
          "from": "/guide/getting-started",
          "to": "/start/quickstart"
        },
        {
          "from": "/guide/authorization",
          "to": "/start/authentication"
        },
        {
          "from": "/guide/b2b-api",
          "to": "/guides/bet-slips"
        },
        {
          "from": "/guide/code-examples/:pathMatch(.*)*",
          "to": "/start/quickstart"
        },
        {
          "from": "/guide/reference-data/:pathMatch(.*)*",
          "to": "/guides/discovery"
        },
        {
          "from": "/guide/rest-api-point-in-time-data/:pathMatch(.*)*",
          "to": "/guides/odds"
        },
        {
          "from": "/guide/graphql-api-realtime-updates/:pathMatch(.*)*",
          "to": "/guides/streaming/overview"
        },
        {
          "from": "/guides/streaming",
          "to": "/guides/streaming/overview"
        },
        {
          "from": "/guide/release-notes/:pathMatch(.*)*",
          "to": "/changelog"
        }
      ]
    },
    "logo": "assets/unabated-logo.svg",
    "theme": "assets/docs.css",
    "colorScheme": {
      "default": "dark",
      "showToggle": false
    },
    "layout": {
      "header": true,
      "pageActions": true,
      "pageTitle": false,
      "sidebar": {
        "enabled": true
      }
    },
    "llms": {
      "stripComments": true
    }
  },
  "versions": {
    "default": {
      "title": "v1",
      "header": [
        {
          "type": "link",
          "title": "Start",
          "to": "/start/quickstart"
        },
        {
          "type": "link",
          "title": "Guides",
          "to": "/guides/odds"
        },
        {
          "type": "link",
          "title": "API reference",
          "to": "/reference"
        },
        {
          "type": "link",
          "title": "Changelog",
          "to": "/changelog"
        },
        {
          "type": "link",
          "title": "Get your API key \u2197",
          "to": "https://tools.unabated.com/api-keys",
          "align": "end"
        }
      ],
      "routes": {
        "/start": {
          "type": "group",
          "title": "Start building",
          "mode": "folder",
          "children": {
            "/quickstart": {
              "type": "page",
              "title": "Quickstart",
              "filepath": "start/quickstart.md",
              "layout": {
                "toc": false,
                "pageTitle": false
              },
              "icon": "phosphor/regular/rocket"
            },
            "/access-tiers": {
              "type": "page",
              "title": "Access tiers",
              "filepath": "start/access-tiers.md",
              "icon": "phosphor/regular/stack"
            },
            "/authentication": {
              "type": "page",
              "title": "Authentication",
              "filepath": "start/authentication.md",
              "icon": "phosphor/regular/key"
            },
            "/agents": {
              "type": "page",
              "title": "Build with an agent",
              "filepath": "start/agents.md",
              "icon": "phosphor/regular/robot"
            }
          }
        },
        "/guides": {
          "type": "group",
          "title": "Guides",
          "mode": "folder",
          "children": {
            "/odds": {
              "type": "page",
              "title": "Get odds",
              "filepath": "guides/odds.md",
              "icon": "phosphor/regular/chart-line"
            },
            "/deep-links": {
              "type": "page",
              "title": "Publish deep links",
              "filepath": "guides/deep-links.md",
              "icon": "phosphor/regular/link"
            },
            "/bet-slips": {
              "type": "page",
              "title": "Generate a bet slip",
              "filepath": "guides/bet-slips.md",
              "icon": "phosphor/regular/ticket"
            },
            "/discovery": {
              "type": "page",
              "title": "Discover IDs",
              "filepath": "guides/discovery.md",
              "icon": "phosphor/regular/compass"
            },
            "/response-concepts": {
              "type": "page",
              "title": "Understand the response",
              "filepath": "guides/response-concepts.md",
              "icon": "phosphor/regular/tree-structure"
            },
            "/errors-and-limits": {
              "type": "page",
              "title": "Errors and limits",
              "filepath": "guides/errors-and-limits.md",
              "icon": "phosphor/regular/warning"
            },
            "/streaming": {
              "type": "group",
              "title": "Stream live updates",
              "mode": "folder",
              "children": {
                "/overview": {
                  "type": "page",
                  "title": "Streaming overview",
                  "filepath": "guides/streaming/overview.md",
                  "icon": "phosphor/regular/broadcast"
                },
                "/lifecycle": {
                  "type": "page",
                  "title": "Connect a live stream",
                  "filepath": "guides/streaming/lifecycle.md"
                },
                "/events-and-filters": {
                  "type": "page",
                  "title": "Events and filters",
                  "filepath": "guides/streaming/events-and-filters.md"
                },
                "/recovery": {
                  "type": "page",
                  "title": "Recover and reconnect",
                  "filepath": "guides/streaming/recovery.md"
                },
                "/models": {
                  "type": "page",
                  "title": "NFL in-game model",
                  "filepath": "guides/streaming/models.md"
                }
              }
            }
          }
        },
        "/reference": {
          "type": "openapi",
          "title": "API reference",
          "description": "Endpoint contracts, availability, request examples, and response schemas.",
          "url": "https://data-sandbox.unabated.com/swagger/v1/swagger.json",
          "singlePage": false,
          "config": {
            "servers": [
              {
                "url": "https://data-sandbox.unabated.com",
                "description": "Unabated sandbox"
              }
            ],
            "proxyUrl": "",
            "theme": "none",
            "darkMode": true,
            "documentDownloadType": "none",
            "modelsSectionLabel": "Schemas",
            "defaultHttpClient": {
              "targetKey": "shell",
              "clientKey": "curl"
            },
            "hiddenClients": [
              "ruby",
              "php",
              "go",
              "java",
              "csharp",
              "objc",
              "swift",
              "kotlin",
              "clojure",
              "c",
              "ocaml",
              "powershell",
              "r"
            ]
          }
        },
        "/changelog": {
          "type": "page",
          "title": "Changelog",
          "filepath": "changelog.md",
          "icon": "phosphor/regular/clock-counter-clockwise"
        }
      }
    }
  },
  "publishOnMerge": false,
  "publishPreviews": false,
  "pullRequestComments": false,
  "assetsDir": "assets"
}
